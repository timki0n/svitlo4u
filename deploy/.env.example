# Copy to deploy/.env on the server (never commit .env — the repo is public).

# Image tag of the core service: "latest" or a commit SHA for pinning/rollback.
CORE_TAG=latest
LOG_LEVEL=info
CORE_HTTP_PORT=8090

# Cloudflare Zero Trust → Networks → Tunnels → svitlo4u → token.
CLOUDFLARE_TUNNEL_TOKEN=
