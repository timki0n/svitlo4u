# Copy to deploy/.env on the server (never commit .env — the repo is public).

# Image tag of the core service: "latest" or "sha-<commit>" for pinning/rollback.
CORE_TAG=latest
LOG_LEVEL=info
CORE_HTTP_PORT=8090

# Cloudflare Zero Trust → Networks → Tunnels → svitlo4u → token.
CLOUDFLARE_TUNNEL_TOKEN=

# Zigbee coordinator. /dev/zigbee needs the udev rule (sudo); otherwise the by-id path works.
ZIGBEE_DEVICE=/dev/zigbee
# ZIGBEE_DEVICE=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0

# Owner of the deploy dir (id -u / id -g) — zigbee2mqtt runs as this user.
PUID=1000
PGID=1000

# MQTT password of the "core" user (same as in mosquitto/config/passwd).
MQTT_CORE_PASSWORD=

# Public origin. Telegram webhooks are registered at $PUBLIC_URL/telegram/<site id>; without it the
# core falls back to long polling. TELEGRAM_UPDATES=webhook|polling|off overrides the choice.
PUBLIC_URL=https://svitlo4u.info

# Secrets named in config/sites.yaml (devices: secretEnv, telegram: botTokenEnv).
ESP_4U_SECRET=
TG_4U_TOKEN=
